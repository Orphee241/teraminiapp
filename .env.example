# Public origin used for exact CSRF/origin validation
PUBLIC_APP_ORIGIN=https://app.terainterface.com
# Required in production. Generate with `node scripts/hash-admin-password.mjs` in an interactive terminal; store the resulting literal hash in Dokploy.
TERAMINI_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<hex-salt>$<hex-digest>
TERAMINI_ADMIN_SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
INVOICE_API_URL=https://invoice-api.example.invalid
INVOICE_API_KEY=
INVOICE_OWNER_SIGNING_SECRET=
TERAPAY_API_URL=https://terapay.example.invalid
TERAPAY_SERVICE_TOKEN=
MICHELLE_API_URL=https://michelle.example.invalid
MICHELLE_API_KEY=
MICHELLE_TURSO_DATABASE_URL=
MICHELLE_TURSO_AUTH_TOKEN=
GARAGE_ENDPOINT=https://storage.example.invalid
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_BUCKET=terainterface
DOCUMENT_DOWNLOAD_ALLOWED_HOSTS=
